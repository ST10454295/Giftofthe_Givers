@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donate";
}

<div class="container py-5">

    <div class="row justify-content-center g-4">


        <div class="col-lg-7">

            <div class="form-card">

                <span class="eyebrow">
                    DONATE
                </span>

                <h1>
                    Make a Donation
                </h1>

                <p>
                    Your contribution helps support
                    communities in need.
                </p>


                <form asp-controller="Donation" asp-action="Index"
                      method="post">


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>


                    <div class="mb-3">

                        <label asp-for="DonationType"
                               class="form-label">

                            Donation Type

                        </label>


                        <div>

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="DonationType"
                                       value="One-time"
                                       checked />

                                <label class="form-check-label">

                                    One-time Donation

                                </label>

                            </div>


                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="DonationType"
                                       value="Recurring" />

                                <label class="form-check-label">

                                    Recurring Donation

                                </label>

                            </div>

                        </div>

                        <span asp-validation-for="DonationType"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Amount"
                               class="form-label">

                            Amount

                        </label>

                        <input asp-for="Amount"
                               class="form-control"
                               placeholder="Enter amount" />

                        <span asp-validation-for="Amount"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Currency"
                               class="form-label">

                            Currency

                        </label>


                        <select asp-for="Currency"
                                class="form-select">

                            <option value="ZAR">
                                ZAR - South African Rand
                            </option>

                            <option value="USD">
                                USD - US Dollar
                            </option>

                            <option value="EUR">
                                EUR - Euro
                            </option>

                        </select>

                    </div>


                    <div class="form-check mb-4">

                        <input asp-for="IsAnonymous"
                               class="form-check-input" />

                        <label asp-for="IsAnonymous"
                               class="form-check-label">

                            Donate anonymously

                        </label>

                    </div>


                    <button type="submit"
                            class="btn btn-success btn-lg">

                        Donate Now

                    </button>


                </form>

            </div>

        </div>


        <div class="col-lg-4">

            <div class="impact-card">

                <div class="gold-heart">
                    ♥
                </div>

                <h2>
                    Your Impact
                </h2>

                <p>

                    Your contribution can help provide
                    food, shelter, medical assistance
                    and other forms of humanitarian relief.

                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
