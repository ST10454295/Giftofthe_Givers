@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="page-heading">

        <span class="eyebrow">
            ABOUT US
        </span>

        <h1>
            Compassion in Action
        </h1>

        <p class="lead">
            Supporting communities through humanitarian
            assistance, compassion and practical action.
        </p>

    </div>


    <div class="row align-items-center g-5 mt-4">

        <div class="col-lg-6">

            <h2>
                Our Mission
            </h2>

            <p>

                Our mission is to provide humanitarian
                assistance to communities affected by
                poverty, disasters and other emergencies.

            </p>

            <p>

                This website prototype provides a digital
                platform for donations, volunteers and
                employees involved in relief projects.

            </p>

        </div>


        <div class="col-lg-6">

            <div class="about-card">

                <div class="display-1">
                    🤝
                </div>

                <h3>
                    Helping Communities Together
                </h3>

                <p>
                    Every contribution can make a difference.
                </p>

            </div>

        </div>

    </div>

</div>